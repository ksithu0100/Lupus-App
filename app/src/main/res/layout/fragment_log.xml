<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textView1"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="What symptom would you like to log?"
        android:textSize="25sp"
        app:layout_constraintTop_toTopOf="@+id/frameLayout" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="337dp"
        android:layout_height="130dp"
        android:layout_gravity="center_vertical"
        android:background="#D3D3D3"
        android:gravity="top|center"
        android:text="Symptom 1"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="@+id/frameLayout"
        app:layout_constraintStart_toStartOf="@+id/frameLayout"
        app:layout_constraintTop_toBottomOf="@+id/textView1" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="331dp"
        android:layout_height="89dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/textView"
        app:layout_constraintEnd_toEndOf="@+id/textView"
        app:layout_constraintStart_toStartOf="@+id/textView">

        <TextView
            android:id="@+id/rating_value_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="Scale Value: 1"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/scale_seek_bar"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:max="10"
            android:min="1"
            android:progress="1" /> <!-- The 'min' attribute requires API 26 or higher -->

    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".LogFragment" />
</androidx.constraintlayout.widget.ConstraintLayout>

