<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Profile header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_placeholder"
                    android:contentDescription="Profile picture"
                    android:background="@drawable/profile_circle"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Name"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/profileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="name@gmail.com"
                        android:textSize="14sp"
                        android:textColor="#666666" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: My Profile -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY PROFILE"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingBottom="8dp" />

            <include layout="@layout/profile_section_item"
                android:id="@+id/aboutMe" />

            <include layout="@layout/profile_section_item"
                android:id="@+id/healthInfo" />

            <include layout="@layout/profile_section_item"
                android:id="@+id/trackingPreferences" />

            <!-- Section: Export My Data -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPORT MY DATA"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingBottom="8dp" />

            <include layout="@layout/profile_section_item"
                android:id="@+id/exportPdf" />

            <include layout="@layout/profile_section_item"
                android:id="@+id/exportOther" />

            <!-- Section: Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingBottom="8dp" />

            <include layout="@layout/profile_section_item"
                android:id="@+id/accountSettings" />

            <include layout="@layout/profile_section_item"
                android:id="@+id/helpCenter" />

            <include layout="@layout/profile_section_item"
                android:id="@+id/logout" />

            <!-- Version text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.00"
                android:textSize="12sp"
                android:textColor="#999999"
                android:paddingTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- COPY PASTABLE BOTTOM NAV BUTTONS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/imgHomeBtn"
            android:layout_width="82dp"
            android:layout_height="65dp"
            android:scaleType="fitXY"
            android:src="@drawable/home"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/imgCalendarBtn"
            android:layout_width="82dp"
            android:layout_height="65dp"
            android:scaleType="fitXY"
            android:src="@drawable/calendar"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgHomeBtn" />

        <ImageButton
            android:id="@+id/imgAddBtn"
            android:layout_width="83dp"
            android:layout_height="65dp"
            android:scaleType="fitXY"
            android:src="@drawable/plus"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgCalendarBtn" />

        <ImageButton
            android:id="@+id/imgJournalBtn"
            android:layout_width="82dp"
            android:layout_height="65dp"
            android:scaleType="fitXY"
            android:src="@drawable/journal"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgAddBtn" />

        <ImageButton
            android:id="@+id/imgProfileBtn"
            android:layout_width="82dp"
            android:layout_height="65dp"
            android:scaleType="fitXY"
            android:src="@drawable/profile"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgJournalBtn" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
