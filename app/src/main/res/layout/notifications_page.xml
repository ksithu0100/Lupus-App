<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/imghomebttn"
        android:layout_width="82dp"
        android:layout_height="65dp"
        android:scaleType="fitXY"
        android:src="@drawable/home"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="0dp" />

    <ImageButton
        android:id="@+id/imgcalendarbttn"
        android:layout_width="82dp"
        android:layout_height="65dp"
        android:scaleType="fitXY"
        android:src="@drawable/calendar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imghomebttn" />

    <ImageButton
        android:id="@+id/imgaddbuttn"
        android:layout_width="83dp"
        android:layout_height="65dp"
        android:scaleType="fitXY"
        android:src="@drawable/plus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgcalendarbttn" />

    <ImageButton
        android:id="@+id/imgjounralbttn"
        android:layout_width="82dp"
        android:layout_height="65dp"
        android:scaleType="fitXY"
        android:src="@drawable/journal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgaddbuttn" />

    <ImageButton
        android:id="@+id/imgprofilebttn"
        android:layout_width="82dp"
        android:layout_height="65dp"
        android:scaleType="fitXY"
        android:src="@drawable/profile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgjounralbttn" />

    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:id="@+id/btnAlarm"
        android:text="Set alarm" />
        android:



</androidx.constraintlayout.widget.ConstraintLayout>